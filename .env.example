# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API Keys). If unset, forms still save to the
# database but skip sending notification emails (dev-friendly fallback).
RESEND_API_KEY=
EMAIL_FROM="MPE Dallas <notifications@mpedallas.com>"
SECURITY_TEAM_EMAIL=merrimanparkestates@gmail.com

# Google Calendar (Google Cloud Console → APIs & Services → Credentials).
# Create a simple API key restricted to the Calendar API, and use the
# Calendar ID of a PUBLIC HOA-owned Google Calendar (Calendar Settings →
# Integrate calendar → Calendar ID).
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=

# Passkeys (WebAuthn). RP_ID is the bare domain (no protocol/port) —
# "localhost" in dev, "mpedallas.com" in production. ORIGIN is the full
# origin the browser is actually on.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Merriman Park Estates"
WEBAUTHN_ORIGIN=http://localhost:3000

# Signs the short-lived cookie used mid-signup (steps 1-3). Any long random
# string; falls back to SUPABASE_SERVICE_ROLE_KEY if unset.
SIGNUP_SESSION_SECRET=

# Authenticates Vercel Cron's request to /api/cron/keepalive. Generate any
# random string and add the same value in Vercel's Cron settings.
CRON_SECRET=

# Stripe (stripe.com → Dashboard → API Keys). PUBLISHABLE_KEY for client-side
# Stripe.js, SECRET_KEY for server-side API calls, WEBHOOK_SECRET for webhook
# signature verification (Dashboard → Webhooks → Signing secret, after adding
# the /api/webhooks/stripe endpoint). If unset, payment forms still render but
# will show an error message on submit (dev-friendly fallback).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
